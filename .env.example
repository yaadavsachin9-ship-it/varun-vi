# DRAIN-GUARD AI -- backend / simulator configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored. This file is not, so it must never contain a real key.

# ---- Application ----
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# ---- Database ----
# Postgres + PostGIS + TimescaleDB (what a deployment should use):
# DATABASE_URL=postgresql+asyncpg://sih_user:sih_password@localhost:5432/sih_flood_db
# Zero-setup local dev, no Docker needed (this is the default the app falls back to):
DATABASE_URL=sqlite+aiosqlite:///./data/flood_prediction.db

# ---- Redis ----
# Only needed to fan WebSocket events across more than one API process.
# With USE_REDIS=false the app uses an in-memory channel manager, which is correct
# for a single-process demo and wrong for a multi-worker deployment.
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# ---- Meteorology ----
# OpenWeather: free tier is enough. https://openweathermap.org/api  (32-char hex key)
# Open-Meteo needs no key.
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ---- Alert delivery ----
# Leave ALERT_SIMULATION_MODE=true and every dispatch is written to the alert log
# instead of being sent. Only set it to false with credentials you own and numbers
# you are authorised to message -- this system sends evacuation orders.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_sender_number_here
ALERT_SIMULATION_MODE=true

# ---- Supabase (operator sign-in) ----
# Backend use only. The service_role key bypasses row-level security, so it stays
# server-side: never in the frontend, never in a VITE_-prefixed variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- Demo simulator ----
DEFAULT_REGION=Chamoli_Valley_Uttarakhand
SIMULATOR_TICK_SECONDS=5
STORM_RAMP_MINUTES=3
MODEL_RETRAIN_INTERVAL_HOURS=24
