# ---- Secrets ----
# The one line in this file that actually matters. `.env` holds live OpenWeather /
# Twilio / Supabase credentials; `.env.example` is the committed template.
.env
.env.local
.env.*.local
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Runtime data ----
# The SQLite database is rebuilt from `python -m data.migrate_schema` plus the two
# seed scripts, so it is generated state, not source.
data/*.db
data/*.db-journal
data/*.sqlite3
*.log
logs/

# ---- Node / frontend build output ----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---- Editors and OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- Kept on purpose ----
# ml/susceptibility_model.joblib is committed deliberately: the demo has to produce
# identical risk scores on a judge's laptop without a training run first.
