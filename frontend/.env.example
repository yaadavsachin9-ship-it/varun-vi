# VARUN -- frontend configuration
#
# Copy to `.env.local` and fill in:   cp .env.example .env.local
#
# Everything here ends up in the JavaScript bundle. Vite inlines every VITE_-prefixed
# variable at build time, so these values are readable by anyone who opens the site.
# Only put public values in this file. The Supabase anon key is designed to be public
# and is safe here; the service_role key is not and must never appear -- access control
# comes from row-level security on the Supabase side, not from hiding a key.

# Where the FastAPI backend is reachable. The WebSocket URL is derived from this.
VITE_API_BASE=http://localhost:8000

# Supabase project for operator sign-in. Leave both blank to run in demo mode:
# LoginPage accepts any identity, labels the session as a demo on screen, and no
# network call is made. Project settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=